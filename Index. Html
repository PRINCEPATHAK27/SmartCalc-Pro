<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartCalc Pro - Free Online Calculator</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <div class="logo">SmartCalc <span>Pro</span></div>
    <nav>
        <a href="#home">Home</a>
        <a href="#calculators">Calculators</a>
        <a href="#history">History</a>
        <a href="videowall.html">📺 Views+</a>
        <button id="themeBtn">🌙</button>
    </nav>
</header>

<section class="hero" id="home">
    <div class="hero-content">
        <h1>Calculate Everything <br><span>Smartly</span></h1>
        <p>Fast, accurate and simple online calculators for your daily needs.</p>
        <a href="#calculators" class="start-btn">Start Calculating</a>
    </div>
</section>

<section id="calculators">
<h2 class="section-title">All Calculators</h2>
<div class="calculator-grid">

<!-- Basic Calculator -->
<div class="card">
<h3>🧮 Basic Calculator</h3>
<input id="display" type="text" readonly>
<div class="calc-buttons">
<button onclick="press('7')">7</button>
<button onclick="press('8')">8</button>
<button onclick="press('9')">9</button>
<button onclick="press('/')">÷</button>
<button onclick="press('4')">4</button>
<button onclick="press('5')">5</button>
<button onclick="press('6')">6</button>
<button onclick="press('*')">×</button>
<button onclick="press('1')">1</button>
<button onclick="press('2')">2</button>
<button onclick="press('3')">3</button>
<button onclick="press('-')">−</button>
<button onclick="clearDisplay()">C</button>
<button onclick="press('0')">0</button>
<button onclick="calculate()">=</button>
<button onclick="press('+')">+</button>
</div>
</div>

<!-- Age Calculator -->
<div class="card">
<h3>🎂 Age Calculator</h3>
<input type="date" id="dob">
<button onclick="calculateAge()">Calculate Age</button>
<p id="ageResult"></p>
</div>

<!-- EMI Calculator -->
<div class="card">
<h3>🏦 EMI Calculator</h3>
<input type="number" id="loan" placeholder="Loan Amount">
<input type="number" id="rate" placeholder="Interest Rate %">
<input type="number" id="years" placeholder="Years">
<button onclick="calculateEMI()">Calculate EMI</button>
<p id="emiResult"></p>
</div>

<!-- SIP Calculator -->
<div class="card">
<h3>📈 SIP Calculator</h3>
<input type="number" id="sipAmount" placeholder="Monthly Investment">
<input type="number" id="sipRate" placeholder="Expected Return %">
<input type="number" id="sipYears" placeholder="Years">
<button onclick="calculateSIP()">Calculate SIP</button>
<p id="sipResult"></p>
</div>

<!-- Percentage Calculator -->
<div class="card">
<h3>📊 Percentage</h3>
<input type="number" id="percentValue" placeholder="Value">
<input type="number" id="percentTotal" placeholder="Total">
<button onclick="calculatePercentage()">Calculate</button>
<p id="percentResult"></p>
</div>

<!-- GST Calculator -->
<div class="card">
<h3>💰 GST Calculator</h3>
<input type="number" id="gstAmount" placeholder="Amount">
<input type="number" id="gstRate" placeholder="GST %">
<button onclick="calculateGST()">Calculate GST</button>
<p id="gstResult"></p>
</div>

<!-- BMI Calculator -->
<div class="card">
<h3>⚖️ BMI Calculator</h3>
<input type="number" id="weight" placeholder="Weight (KG)">
<input type="number" id="height" placeholder="Height (CM)">
<button onclick="calculateBMI()">Calculate BMI</button>
<p id="bmiResult"></p>
</div>

<!-- Shape Calculator -->
<div class="card">
<h3>📐 Shape Calculator</h3>
<select id="shapeSelect" onchange="showShapeInputs()">
    <option value="">-- Select Shape --</option>
    <option value="circle">Circle</option>
    <option value="rectangle">Rectangle</option>
    <option value="square">Square</option>
    <option value="triangle">Triangle</option>
    <option value="parallelogram">Parallelogram</option>
    <option value="trapezoid">Trapezoid</option>
    <option value="ellipse">Ellipse</option>
    <option value="rhombus">Rhombus</option>
</select>
<div class="shape-inputs" id="inputs-circle"><input type="number" id="circle-r" placeholder="Radius"></div>
<div class="shape-inputs" id="inputs-rectangle"><input type="number" id="rect-l" placeholder="Length"><input type="number" id="rect-w" placeholder="Width"></div>
<div class="shape-inputs" id="inputs-square"><input type="number" id="sq-s" placeholder="Side"></div>
<div class="shape-inputs" id="inputs-triangle"><input type="number" id="tri-a" placeholder="Side A"><input type="number" id="tri-b" placeholder="Side B"><input type="number" id="tri-c" placeholder="Side C"><input type="number" id="tri-h" placeholder="Height (for Area)"></div>
<div class="shape-inputs" id="inputs-parallelogram"><input type="number" id="para-b" placeholder="Base"><input type="number" id="para-h" placeholder="Height"><input type="number" id="para-s" placeholder="Side"></div>
<div class="shape-inputs" id="inputs-trapezoid"><input type="number" id="trap-a" placeholder="Side A (top)"><input type="number" id="trap-b" placeholder="Side B (bottom)"><input type="number" id="trap-c" placeholder="Leg C"><input type="number" id="trap-d" placeholder="Leg D"><input type="number" id="trap-h" placeholder="Height"></div>
<div class="shape-inputs" id="inputs-ellipse"><input type="number" id="ellipse-a" placeholder="Semi-Major Axis (a)"><input type="number" id="ellipse-b" placeholder="Semi-Minor Axis (b)"></div>
<div class="shape-inputs" id="inputs-rhombus"><input type="number" id="rhom-d1" placeholder="Diagonal 1"><input type="number" id="rhom-d2" placeholder="Diagonal 2"><input type="number" id="rhom-s" placeholder="Side (optional)"></div>
<button onclick="calculateShape()">Calculate Area & Perimeter</button>
<p id="shapeResult"></p>
</div>

</div>
</section>

<!-- History -->
<section id="history">
<h2 class="section-title">Calculation History</h2>
<div class="history-box">
<ul id="historyList"></ul>
<button onclick="clearHistory()">Clear History</button>
</div>
</section>

<footer>
<p>© 2026 SmartCalc Pro | All Rights Reserved owner PRINCE PATHAK </p>
</footer>

<script src="main.js"></script>
</body>
</html>