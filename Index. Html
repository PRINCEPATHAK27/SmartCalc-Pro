      <div class="tile-name">BMI Calculator</div>
      <div class="tile-desc">Body mass index</div>
    </a>

    <a href="calculators.html#shape" class="tile">
      <div class="tile-icon">📐</div>
      <div class="tile-name">Shape Calculator</div>
      <div class="tile-desc">Area & circumference</div>
