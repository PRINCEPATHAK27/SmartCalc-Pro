    <a href="calculators.html#age" class="tile">
      <div class="tile-icon">🎂</div>
      <div class="tile-name">Age Calculator</div>
      <div class="tile-desc">Know your exact age</div>
    </a>

    <a href="calculators.html#emi" class="tile">
      <div class="tile-icon">🏦</div>
      <div class="tile-name">EMI Calculator</div>
      <div class="tile-desc">Loan EMI & interest</div>
